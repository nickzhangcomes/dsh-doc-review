{
  "name": "dsh-markup",
  "version": "0.2.0",
  "description": "DSH Markup · 对话批注与文档审阅：原地批注、评论对话、正文修订，读完带回主会话。Inline annotations and document review for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "review",
    "annotation",
    "document",
    "comment"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-api-workspace-controller"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build",
    "test": "node --test scripts/migration.test.mjs"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickzhangcomes/dsh-markup.git"
  },
  "homepage": "https://github.com/nickzhangcomes/dsh-markup#readme",
  "bugs": {
    "url": "https://github.com/nickzhangcomes/dsh-markup/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
